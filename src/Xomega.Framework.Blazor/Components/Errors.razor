@if (ErrorList != null && ErrorList.Errors.Any())
{
    <div class="@Class">
        @foreach (var err in ErrorList.Errors.ToList())
        {
            <div class="mb-1 p-1 d-flex align-items-center alert alert-@GetSeverityClass(err.Severity)">
                <i class="fs-5 me-2 bi bi-@GetIconClass(err.Severity)-fill"></i>
                <span class="flex-fill">@err.Message</span>
                <button type="button" @onclick="@(e => CloseMessage(err, e))" class="btn-close ms-1" aria-label="Close"
                        title="@(ErrorList.Errors.Count() > 1 ? GetCloseAllTip() : null)"></button>
            </div>
        }
    </div>
}

@code {

    /// <summary>
    /// Additional CSS class(es) to apply to the outer container of the error list.
    /// </summary>
    [Parameter]
    public string Class { get; set; }

    /// <summary>
    /// The view resource key prefix used to look up view-specific localized text, such as the shift-click tooltip.
    /// </summary>
    [Parameter]
    public string ViewKey { get; set; }

    /// <summary>
    /// The list of error, warning, info and success messages to display.
    /// </summary>
    [Parameter]
    public ErrorList ErrorList { get; set; }

    /// <summary>
    /// Gets the tooltip text hinting that shift-clicking a message's close button will clear all messages.
    /// </summary>
    protected string GetCloseAllTip() => ErrorList?.GetCloseAllTip(ViewKey);

    /// <summary>
    /// Maps the given error severity to the corresponding Bootstrap alert/contextual class.
    /// </summary>
    protected string GetSeverityClass(ErrorSeverity severity) => severity switch
    {
        ErrorSeverity.Critical or ErrorSeverity.Error => "danger",
        ErrorSeverity.Warning => "warning",
        ErrorSeverity.Info => "info",
        ErrorSeverity.None => "success",
        _ => ""
    };

    /// <summary>
    /// Maps the given error severity to the corresponding Bootstrap Icons class name.
    /// </summary>
    protected string GetIconClass(ErrorSeverity severity) => severity switch
    {
        ErrorSeverity.Critical => "x-octagon",
        ErrorSeverity.Error => "x-circle",
        ErrorSeverity.Warning => "exclamation-triangle",
        ErrorSeverity.Info => "info-circle",
        ErrorSeverity.None => "check-circle",
        _ => ""
    };

    /// <summary>
    /// Closes the given error message, or clears all messages from the list if the Shift key was held during the click.
    /// </summary>
    /// <param name="err">The error message being closed.</param>
    /// <param name="args">Mouse event arguments used to detect the Shift key modifier.</param>
    public void CloseMessage(ErrorMessage err, MouseEventArgs args)
    {
        if (ErrorList == null) return;
        if (args.ShiftKey) ErrorList.Clear();
        else ErrorList.Errors.Remove(err);
    }
}
